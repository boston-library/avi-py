[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[scripts]
avi_jp2_convert = 'bin/avi_jp2_convert'
avi_ffmpeg_thumbnail = 'bin/avi_ffmpeg_thumbnail'
avi_ffmpeg_mp3 = 'bin/avi_ffmpeg_mp3'
avi_ocr = 'bin/avi_ocr'

[packages]
ffmpeg-python = ">=0.2.0"
numpy = ">=1.23"
pytesseract = "~=0.3"
opencv-python = ">=4.12"
dill = "~=0.4"
pillow = "~=12.1"
urllib3 = ">=2.6.3"
certifi = ">=2026.1.4"
setuptools = ">=82.0.0"
image-processing = {editable = true, ref = "1.12.0", git = "git+https://github.com/bodleian/image-processing.git"}


[dev-packages]
pytest = ">=7.2"
pylint = "~=2.14"
coveralls = "~=3.0"
pytest-cov = "~=2.11"

[requires]
python_version = "3.10"
